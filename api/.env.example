# Local server defaults to deterministic mock, with a simulated local approver.
MODEL_PROVIDER=mock
# Deployed Functions ALWAYS require Easy Auth identity and Blob storage.
# Azure OpenAI / Foundry Azure OpenAI-compatible v1 endpoint (not project endpoint):
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
MODEL_DEMAND=retail-fast
MODEL_INVENTORY=retail-fast
MODEL_ALLOCATION=retail-reasoning
MODEL_RISK=retail-risk
# Optional user-assigned identity; omit for system-assigned identity.
AZURE_CLIENT_ID=
STATE_STORAGE_URL=https://YOUR-STORAGE.blob.core.windows.net
DAILY_RUN_LIMIT=30
